# =============================================================================
# AS Finance LMS — Environment Variables
# Copy this file to .env and fill in actual values. Never commit .env to git.
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://asfinance:asfinance_dev@localhost:5432/asfinance_lms?schema=public

# --- JWT Authentication ---
# Production requires >= 64 chars; generate with:
#   openssl rand -base64 64
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- PII encryption (AES-256-GCM) ---
# Required in production. Must decode to exactly 32 bytes (base64) and
# differ from JWT_SECRET. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-bytes-base64

# --- S3 / MinIO (Document Storage) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=as-finance-docs
S3_REGION=us-east-1

# --- SMS Provider ---
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms-provider.example.com/send
SMS_SENDER_ID=ASFIN

# --- Application ---
NODE_ENV=development
PORT=3001

# --- CORS (comma-separated allowed origins for browser requests) ---
# In production, set to your actual frontend domain(s).
# Example: CORS_ORIGINS=https://app.as-finance.com,https://admin.as-finance.com
CORS_ORIGINS=http://localhost:3000
