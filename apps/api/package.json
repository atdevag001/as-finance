{
  "name": "@as-finance/api",
  "version": "0.1.0",
  "private": true,
  "description": "AS Finance LMS — NestJS backend API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.ts",
    "test:e2e": "vitest run -c vitest.e2e.ts",
    "test:pact:verify": "vitest run test/pact/provider-verification.spec.ts -c vitest.e2e.ts",
    "test:chaos": "vitest run test/chaos/ -c vitest.integration.ts",
    "test:load": "k6 run test/load/scenarios/collection-load.js --summary-export=test/load/results.json",
    "test:load:verify": "npx tsx test/load/verify-collection-load.ts",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "create-admin": "tsx ../../scripts/create-admin.ts"
  },
  "dependencies": {
    "@as-finance/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nestjs-pino": "^4.1.0",
    "pdfkit": "^0.18.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@as-finance/config": "workspace:*",
    "@as-finance/testing": "workspace:*",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@pact-foundation/pact": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.0",
    "fast-check": "^3.19.0",
    "pino-pretty": "^11.2.0",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
