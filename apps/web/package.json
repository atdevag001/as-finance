{
  "name": "@as-finance/web",
  "version": "0.1.0",
  "private": true,
  "description": "AS Finance LMS — Next.js frontend",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('public/docs',{recursive:true});require('fs').copyFileSync('../../docs/MIGRATION_FILE_FORMAT.md','public/docs/MIGRATION_FILE_FORMAT.md')\"",
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').mkdirSync('public/docs',{recursive:true});require('fs').copyFileSync('../../docs/MIGRATION_FILE_FORMAT.md','public/docs/MIGRATION_FILE_FORMAT.md')\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config test/playwright.config.ts",
    "test:e2e:headed": "playwright test --config test/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config test/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config test/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report test/test-results/html",
    "test:pact": "vitest run --config test/pact/vitest.pact.ts"
  },
  "dependencies": {
    "@as-finance/shared": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@tanstack/react-query": "^5.51.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.52.0",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@as-finance/config": "workspace:*",
    "@axe-core/playwright": "^4.11.1",
    "@pact-foundation/pact": "^13.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "fast-check": "^3.19.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
