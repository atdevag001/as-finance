# Production environment template. Copy to .env.production and fill real values.
# Real .env.production is .gitignored. Never commit secrets.

NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_ME_WITH_OPENSSL_RAND_64
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# PII encryption — 32 bytes base64. Generate with: openssl rand -base64 32
# MUST differ from JWT_SECRET. Losing this key = losing all encrypted PII.
ENCRYPTION_KEY=REPLACE_ME_WITH_OPENSSL_RAND_32

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=as-finance-docs
