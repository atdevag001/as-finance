{
  "name": "as-finance-lms",
  "version": "0.1.0",
  "private": true,
  "description": "AS Finance Loan Management System — production-grade fullstack lending lifecycle management",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "pnpm --filter @as-finance/api run db:migrate",
    "db:seed": "pnpm --filter @as-finance/api run db:seed",
    "dev:api": "pnpm --filter @as-finance/api run dev",
    "dev:web": "pnpm --filter @as-finance/web run dev",
    "lint:root": "eslint .",
    "format:root": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@as-finance/config": "workspace:*",
    "@pact-foundation/pact": "^16.3.0",
    "@playwright/test": "^1.58.2",
    "@seontechnologies/playwright-utils": "^4.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
