{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "disabled": false,
      "autoApprove": [
        "browser_wait_for",
        "browser_navigate",
        "browser_click",
        "browser_fill_form",
        "browser_snapshot",
        "browser_evaluate",
        "browser_take_screenshot"
      ]
    },
    "playwright-test": {
      "type": "stdio",
      "command": "npx",
      "args": ["playwright", "run-test-mcp-server"],
      "disabled": false,
      "autoApprove": []
    }
  }
}